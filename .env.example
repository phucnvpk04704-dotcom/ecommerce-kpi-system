# System Configuration
PROJECT_NAME="Enterprise Multi-Channel Ecommerce KPI Management System"
APP_NAME="ecommerce_kpi"
ENVIRONMENT="development" # development, staging, production
DEBUG=true

# Database Configuration
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="ecommerce_kpi_system"

# Security Configurations
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-key-for-jwt-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_EXPIRE_HOURS=24

# Mail Dispatch Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="smtp-username@example.com"
SMTP_PASSWORD="smtp-app-password"
SMTP_FROM_EMAIL="noreply@ecommercekpi.com"

# Automated Scheduled Job Switches
ENABLE_JOBS=true
